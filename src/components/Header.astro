---
/**
 * KB Header — blog visual structure with Starlight sub-components.
 *
 * Desktop: [Logo] [Search grows] [SocialIcons · ThemeSelect]
 * Mobile:  [hamburger LEFT (fixed, via CSS)] [Logo CENTER] [Search icon RIGHT]
 *
 * MobileMenuToggle is NOT rendered here — it lives in PageFrame's sidebar nav
 * so the CSS sibling rule ([aria-expanded='true'] ~ .sidebar-pane) that opens
 * the sidebar keeps working. On mobile we just move its fixed button to the
 * left with a CSS override so it matches the blog's layout.
 */
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="has-header-inner">
	<div class="kb-title">
		<SiteTitle />
	</div>
	<div class="kb-search sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden kb-right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style is:global>
	/* ═══════════════════════════════════════════════════════════
	   OUTER WRAPPER  (the <header class="header"> in PageFrame)
	   ═══════════════════════════════════════════════════════════ */
	body header.header {
		background-color: #ffffff !important;
		border-bottom: 1px solid #e5e7eb !important;
		font-family: 'Poppins', system-ui, sans-serif !important;
	}

	/* ═══════════════════════════════════════════════════════════
	   INNER CONTAINER  — mirrors the blog's .has-header-inner
	   ═══════════════════════════════════════════════════════════ */
	.has-header-inner {
		display: flex !important;
		flex-direction: row !important;
		align-items: center !important;
		justify-content: space-between !important;
		max-width: 1536px !important;
		margin: 0 auto !important;
		padding: 0 1rem !important;
		height: 100% !important;
		gap: 1rem !important;
		box-sizing: border-box !important;
	}

	/* Search bar grows to fill the middle column */
	.kb-search {
		flex: 1 !important;
		min-width: 0 !important;
	}

	/* Right group: Explore button + contact icon + theme toggle */
	.kb-right-group {
		display: flex !important;
		align-items: center !important;
		gap: 1rem !important;
		flex-shrink: 0 !important;
	}

	/* Logo — matches blog's 34 px */
	.kb-title .site-title img {
		height: 34px !important;
		width: auto !important;
	}

	/* Re-enable theme select (previously hidden in custom.css) */
	starlight-theme-select {
		display: flex !important;
	}

	/* ═══════════════════════════════════════════════════════════
	   MOBILE  (<50rem)
	   Blog layout: [hamburger LEFT] [logo CENTER] [search RIGHT]

	   Starlight's MobileMenuToggle button is position:fixed at
	   top-right. We move it to the left to match the blog, and
	   center the logo absolutely within the header bar.
	   ═══════════════════════════════════════════════════════════ */
	@media (max-width: 49.999rem) {
		.has-header-inner {
			position: relative !important;
			gap: 0 !important;
		}

		/* Logo centered */
		.kb-title {
			position: absolute !important;
			left: 50% !important;
			top: 50% !important;
			transform: translate(-50%, -50%) !important;
			pointer-events: auto !important;
		}

		/* Search icon pushed to the right */
		.kb-search {
			flex: 0 !important;
			margin-left: auto !important;
		}

		/* Move Starlight's fixed hamburger from top-RIGHT → top-LEFT */
		starlight-menu-button button {
			inset-inline-end: unset !important;
			inset-inline-start: var(--sl-nav-pad-x) !important;
		}

		/*
		 * PageFrame adds padding-inline-end to the header on mobile sidebar pages
		 * to make room for the old right-side hamburger.
		 * Now the hamburger is on the LEFT, so we swap the padding sides.
		 */
		:root[data-has-sidebar] header.header {
			padding-inline-end: var(--sl-nav-pad-x) !important;
			padding-inline-start: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			) !important;
		}
	}

	/* ═══════════════════════════════════════════════════════════
	   STARLIGHT GRID ALIGNMENT  (desktop, ≥50rem)
	   Keeps logo column flush with sidebar, search with content.
	   ═══════════════════════════════════════════════════════════ */
	@media (min-width: 50rem) {
		:root[data-has-sidebar] {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:root:not([data-has-toc]) {
			--__toc-width: 0rem;
		}
		.has-header-inner {
			--__sidebar-width: max(
				0rem,
				var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)
			);
			--__main-column-fr: calc(
				(
					100% + var(--__sidebar-pad, 0rem)
					- var(--__toc-width, var(--sl-sidebar-width))
					- (2 * var(--__toc-width, var(--sl-nav-pad-x)))
					- var(--sl-content-inline-start, 0rem)
					- var(--sl-content-width)
				) / 2
			);
			display: grid !important;
			grid-template-columns:
				minmax(
					calc(
						var(--__sidebar-width) +
						max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))
					),
					auto
				)
				1fr
				auto !important;
			align-content: center !important;
		}
	}
</style>
