---
/**
 * Custom header that composes Starlight's sub-components unchanged so all
 * built-in functionality (search, sidebar toggle, theme select, keyboard
 * navigation, a11y) is fully preserved. Only the visual layer is added here
 * to match the Haveaspot blog header: white background, #e5e7eb border,
 * Poppins font, 64px height, logo | search | [spacer] | right-group layout.
 */
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style is:global>
	/* ── Blog-matching visual overrides ─────────────────────────────────────
	   The outer <header class="header"> lives in PageFrame. We target it with
	   a body-prefixed selector so specificity beats the #FAFAFA rule that was
	   previously in custom.css, without touching PageFrame.astro itself.     */

	body header.header {
		border-bottom: 1px solid #e5e7eb !important;
		background-color: #ffffff !important;
		font-family: 'Poppins', system-ui, sans-serif !important;
	}

	/* Show theme select — custom.css previously hid it; re-enable here so the
	   layout is [ Logo | Search | spacer | ThemeSelect ] as specified.        */
	starlight-theme-select {
		display: flex !important;
	}

	/* Keep logo height consistent with blog (34 px) */
	.site-title img {
		height: 34px !important;
		width: auto !important;
	}
</style>

<style>
	/* ── Layout — identical to Starlight's built-in Header.astro ───────────── */
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering search/menu on narrow viewports */
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}

			/* Grid aligns the logo column with the sidebar, the search with the
			   content column, and the right group to whatever space remains. */
			.header {
				--__sidebar-width: max(
					0rem,
					var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)
				);
				--__main-column-fr: calc(
					(
						100% + var(--__sidebar-pad, 0rem)
						- var(--__toc-width, var(--sl-sidebar-width))
						- (2 * var(--__toc-width, var(--sl-nav-pad-x)))
						- var(--sl-content-inline-start, 0rem)
						- var(--sl-content-width)
					) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(
							var(--__sidebar-width) +
							max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))
						),
						auto
					)
					1fr
					auto;
				align-content: center;
			}
		}
	}
</style>
