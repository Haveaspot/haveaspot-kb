---
<div class="hero-search-container">
  <div class="hero-search-label">
    <span class="hero-search-heading">How can we help?</span>
    <span class="hero-search-subtext">Type a keyword to search our knowledge base.</span>
  </div>
  <button class="hero-search-btn" id="hero-search-trigger" aria-label="Open search">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    Search the knowledge base…
  </button>
</div>

<script>
  function openStarlightSearch() {
    const siteSearch = document.querySelector('site-search');
    if (!siteSearch) return;
    const dialog = siteSearch.querySelector('dialog') as HTMLDialogElement | null;
    if (!dialog || dialog.open) return;

    dialog.showModal();
    document.body.toggleAttribute('data-search-modal-open', true);

    // Focus the search input once the dialog is visible
    requestAnimationFrame(() => {
      (siteSearch.querySelector('input') as HTMLInputElement | null)?.focus();
    });

    // Close when clicking outside the dialog frame
    const dialogFrame = siteSearch.querySelector('.dialog-frame');
    function handleOutsideClick(e: MouseEvent) {
      if (dialogFrame && !dialogFrame.contains(e.target as Node)) {
        dialog!.close();
        document.body.removeAttribute('data-search-modal-open');
        window.removeEventListener('click', handleOutsideClick);
      }
    }
    // Delay so this click doesn't immediately close it
    setTimeout(() => window.addEventListener('click', handleOutsideClick), 0);
  }

  document.getElementById('hero-search-trigger')
    ?.addEventListener('click', openStarlightSearch);
</script>
